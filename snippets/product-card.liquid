{%- comment -%}
  Product card with an in-card variant picker.

  Usage:
    {% render 'product-card', product: product %}

  Variant data is embedded as JSON so switching options needs no network request.
  Without JavaScript, the card is still a normal form that posts to /cart/add.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
  endif
  assign image = v.featured_image | default: product.featured_media
-%}

<product-card
  class="pcard"
  data-money-format="{{ shop.money_format | escape }}"
  data-add-label="Add to cart"
  data-sold-out="Sold out"
  data-unavailable="Unavailable"
  data-added="Added to cart"
>
  <a href="{{ v.url }}" class="pcard__media" data-link data-image tabindex="-1" aria-hidden="true">
    {%- if image -%}
      {{
        image
        | image_url: width: 600
        | image_tag:
          widths: '300, 450, 600',
          sizes: '(min-width: 990px) 25vw, 50vw',
          loading: 'lazy',
          class: 'pcard__img',
          alt: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'pcard__img' }}
    {%- endif -%}
  </a>

  <a href="{{ v.url }}" class="pcard__title" data-link>{{ product.title | escape }}</a>

  <div class="pcard__price">
    <span data-price>{{ v.price | money }}</span>
    <s data-compare{% unless on_sale %} hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
    <span class="pcard__badge" data-off{% unless on_sale %} hidden{% endunless %}>
      {%- if on_sale -%}
        {{- v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -}}
        % OFF
      {%- endif -%}
    </span>
  </div>

  {%- unless product.has_only_default_variant -%}
    <div class="pcard__options">
      {%- for option in product.options_with_values -%}
        <fieldset class="pcard__option">
          <legend class="pcard__legend">{{ option.name | escape }}</legend>
          {%- for value in option.values -%}
            <button
              type="button"
              class="pcard__chip"
              data-option-index="{{ forloop.parentloop.index0 }}"
              data-value="{{ value.name | escape }}"
              aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
            >
              {{- value.name | escape -}}
            </button>
          {%- endfor -%}
        </fieldset>
      {%- endfor -%}
    </div>
  {%- endunless -%}

  {%- comment -%} Always embedded, so single-variant cards also get the on-page Add to cart. {%- endcomment -%}
    <script type="application/json" data-variants>
      [
        {%- for variant in product.variants -%}
          {%- liquid
            assign vimg = variant.featured_image | default: product.featured_media
            capture srcset
              if vimg
                echo vimg | image_url: width: 300 | append: ' 300w, '
                echo vimg | image_url: width: 450 | append: ' 450w, '
                echo vimg | image_url: width: 600 | append: ' 600w'
              endif
            endcapture
          -%}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available | json }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "url": {{ variant.url | json }},
            "image": {% if vimg %}{ "src": {{ vimg | image_url: width: 600 | json }}, "srcset": {{ srcset | json }} }{% else %}null{% endif %}
          }
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      ]
    </script>

  <form action="{{ routes.cart_add_url }}" method="post" class="pcard__form" data-add>
    <input type="hidden" name="id" value="{{ v.id }}">
    <input type="hidden" name="quantity" value="1">
    <button type="submit" class="pcard__atc"{% unless v.available %} disabled{% endunless %}>
      {%- if v.available %}Add to cart{% else %}Sold out{% endif -%}
    </button>
  </form>
  <p class="pcard__status" data-status role="status" aria-live="polite"></p>
</product-card>
