{%- comment -%}
  Pincode delivery estimate for the product page.
  Pincode lists live in assets/pincode-delivery.json and load only when the
  shopper focuses the field. Every message is editable in the theme editor.
{%- endcomment -%}
<script src="{{ 'delivery-estimate.js' | asset_url }}" defer></script>

<div class="dest section-{{ section.id }}">
  <delivery-estimate
    data-src="{{ 'pincode-delivery.json' | asset_url }}"
    data-fast="{{ section.settings.fast_text | escape }}"
    data-standard="{{ section.settings.standard_text | escape }}"
    data-other="{{ section.settings.other_text | escape }}"
    data-error="{{ section.settings.error_text | escape }}"
    data-loading="Checking…"
  >
    <form class="dest__form" novalidate>
      <label class="dest__label" for="Pincode-{{ section.id }}">{{ section.settings.heading | escape }}</label>
      <div class="dest__row">
        <input
          id="Pincode-{{ section.id }}"
          class="dest__input"
          type="text"
          name="pincode"
          inputmode="numeric"
          autocomplete="postal-code"
          maxlength="6"
          placeholder="6-digit pincode"
          aria-describedby="PincodeResult-{{ section.id }}"
        >
        <button type="submit" class="dest__button">{{ section.settings.button_label | escape }}</button>
      </div>
      <p id="PincodeResult-{{ section.id }}" class="dest__result" data-result role="status" aria-live="polite"></p>
    </form>
  </delivery-estimate>
</div>

{% stylesheet %}
  .dest { max-width: 480px; padding: 16px 0; }
  delivery-estimate { display: block; }
  .dest__form { display: grid; gap: 8px; }
  .dest__label { font-weight: 600; }
  .dest__row { display: flex; gap: 8px; }
  .dest__input { flex: 1; min-width: 0; font: inherit; padding: 10px 12px; border: 1px solid rgba(0, 0, 0, .25); border-radius: 8px; letter-spacing: .08em; }
  .dest__input[aria-invalid="true"] { border-color: #b3261e; }
  .dest__button { font: inherit; padding: 10px 16px; border: 0; border-radius: 8px; background: #141821; color: #fff; cursor: pointer; }
  .dest__result { min-height: 1.4em; margin: 0; }
  .dest__result[data-state="fast"] { color: #1f7a4d; font-weight: 600; }
  .dest__result[data-state="error"] { color: #b3261e; }
{% endstylesheet %}

{% schema %}
{
  "name": "Delivery estimate",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check delivery time" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Check" },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "fast_text", "label": "Fast pincodes", "default": "Delivery in 2 business days" },
    { "type": "text", "id": "standard_text", "label": "Standard pincodes", "default": "Delivery in 3–5 business days" },
    { "type": "text", "id": "other_text", "label": "Valid pincode not in the list", "info": "Also shown if the pincode list fails to load.", "default": "Delivery in 5–7 business days" },
    { "type": "text", "id": "error_text", "label": "Invalid pincode", "default": "Please enter a valid 6-digit pincode" }
  ],
  "presets": [{ "name": "Delivery estimate" }]
}
{% endschema %}
