{%- comment -%}
  Demo grid for the product-card snippet: pick a collection in the theme editor
  and every card gets its own variant picker and on-page Add to cart.
{%- endcomment -%}
<script src="{{ 'cart-api.js' | asset_url }}" defer></script>
<script src="{{ 'product-card.js' | asset_url }}" defer></script>

<div
  class="vgrid section-{{ section.id }}"
  style="--vgrid-cols: {{ section.settings.columns_desktop }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="vgrid__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- assign collection = section.settings.collection -%}
  {%- if collection != blank and collection.products_count > 0 -%}
    <ul class="vgrid__list" role="list">
      {%- for product in collection.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="vgrid__empty">Choose a collection with products in this section's settings.</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .vgrid { max-width: 1200px; margin: 0 auto; padding: 40px 16px; }
  .vgrid__heading { margin: 0 0 24px; }
  .vgrid__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 990px) { .vgrid__list { grid-template-columns: repeat(var(--vgrid-cols, 4), minmax(0, 1fr)); } }
  .vgrid__empty { padding: 24px; border: 1px dashed currentColor; opacity: .7; }

  product-card { display: flex; flex-direction: column; gap: 8px; height: 100%; }
  .pcard__media { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 12px; background: rgba(0, 0, 0, .04); }
  .pcard__img { width: 100%; height: 100%; object-fit: cover; }
  .pcard__title { font-weight: 600; text-decoration: none; color: inherit; }
  .pcard__price { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
  .pcard__price s { opacity: .6; }
  .pcard__badge { font-size: .8em; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #1e5a44; color: #fff; }
  .pcard__options { display: grid; gap: 6px; }
  .pcard__option { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .pcard__legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pcard__chip { font: inherit; font-size: .85em; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(0, 0, 0, .2); background: transparent; color: inherit; cursor: pointer; }
  .pcard__chip[aria-pressed="true"] { border-color: currentColor; box-shadow: inset 0 0 0 1px currentColor; }
  .pcard__form { margin-top: auto; }
  .pcard__atc { width: 100%; font: inherit; padding: 10px; border-radius: 8px; border: 0; background: #141821; color: #fff; cursor: pointer; }
  .pcard__atc:disabled { opacity: .5; cursor: not-allowed; }
  .pcard__atc[aria-busy="true"] { cursor: progress; }
  .pcard__status { min-height: 1.4em; margin: 0; font-size: .85em; }
{% endstylesheet %}

{% schema %}
{
  "name": "Variant card grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the range" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Variant card grid" }]
}
{% endschema %}
